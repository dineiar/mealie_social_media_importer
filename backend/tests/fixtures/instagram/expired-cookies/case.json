{
  "case": "expired-cookies",
  "note": "A public post requested with a cookies file whose session cookie is invalid.",
  "tools": {
    "gallery-dl": "1.32.18",
    "yt-dlp": "2026.10.26"
  },
  "input_url": "https://www.instagram.com/p/Dsynth00001/",
  "runs": {
    "gallery-dl.dump-json": {
      "args": [
        "--cookies",
        "<cookies>",
        "-j",
        "-o",
        "videos=merged",
        "-o",
        "previews=video",
        "-o",
        "sleep-429=0",
        "-o",
        "max-posts=1",
        "--",
        "<url>"
      ],
      "url": "https://www.instagram.com/p/Dsynth00001/",
      "exit_code": 0,
      "stdout": "gallery-dl.dump-json.stdout.json",
      "stderr": null
    },
    "gallery-dl.download": {
      "args": [
        "--cookies",
        "<cookies>",
        "-D",
        "<dir>",
        "-f",
        "{num:>02}.{extension}",
        "--write-info-json",
        "--write-metadata",
        "-o",
        "videos=merged",
        "-o",
        "previews=video",
        "-o",
        "sleep-429=0",
        "-o",
        "max-posts=1",
        "--filesize-max",
        "250M",
        "--",
        "<url>"
      ],
      "url": "https://www.instagram.com/p/Dsynth00001/",
      "exit_code": 4,
      "stdout": null,
      "stderr": "gallery-dl.download.stderr.txt",
      "writes": []
    },
    "yt-dlp.download": {
      "args": [
        "--cookies",
        "<cookies>",
        "--no-progress",
        "-o",
        "<dir>/%(id)s.%(ext)s",
        "<url>"
      ],
      "url": "https://www.instagram.com/reels/Dsynth00002/",
      "exit_code": 1,
      "stdout": "yt-dlp.download.stdout.txt",
      "stderr": "yt-dlp.download.stderr.txt",
      "writes": []
    }
  }
}
