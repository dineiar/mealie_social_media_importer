{
  "case": "photo",
  "note": "A public single-photo recipe post.",
  "tools": {
    "gallery-dl": "1.32.18",
    "yt-dlp": "2026.10.26"
  },
  "input_url": "https://www.instagram.com/p/Dsynth00001/",
  "runs": {
    "gallery-dl.dump-json": {
      "args": [
        "--cookies",
        "<cookies>",
        "-j",
        "-o",
        "videos=merged",
        "-o",
        "previews=video",
        "-o",
        "sleep-429=0",
        "-o",
        "max-posts=1",
        "--",
        "<url>"
      ],
      "url": "https://www.instagram.com/p/Dsynth00001/",
      "exit_code": 0,
      "stdout": "gallery-dl.dump-json.stdout.json",
      "stderr": null
    },
    "gallery-dl.download": {
      "args": [
        "--cookies",
        "<cookies>",
        "-D",
        "<dir>",
        "-f",
        "{num:>02}.{extension}",
        "--write-info-json",
        "--write-metadata",
        "-o",
        "videos=merged",
        "-o",
        "previews=video",
        "-o",
        "sleep-429=0",
        "-o",
        "max-posts=1",
        "--filesize-max",
        "250M",
        "--",
        "<url>"
      ],
      "url": "https://www.instagram.com/p/Dsynth00001/",
      "exit_code": 0,
      "stdout": "gallery-dl.download.stdout.txt",
      "stderr": null,
      "writes": [
        {
          "name": "01.jpg",
          "kind": "image"
        },
        {
          "name": "01.jpg.json",
          "kind": "json",
          "source": "files/01.jpg.json"
        },
        {
          "name": "info.json",
          "kind": "json",
          "source": "files/info.json"
        }
      ]
    },
    "yt-dlp.dump-json": {
      "args": [
        "--cookies",
        "<cookies>",
        "-j",
        "<url>"
      ],
      "url": "https://www.instagram.com/p/Dsynth00001/",
      "exit_code": 1,
      "stdout": null,
      "stderr": "yt-dlp.dump-json.stderr.txt",
      "stdout_json_lines": 0
    }
  }
}
